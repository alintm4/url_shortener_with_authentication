<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  </head>
  <body class="bg-gray-100 text-gray-800 font-sans">
    <div class="max-w-4xl mx-auto p-4">
      <h1 class="text-4xl font-bold text-center mb-6">
        <a href="/" class="hover:underline text-blue-600">URL Shortener</a>
      </h1>
      
      <% if (locals.id) { %>
        <div class="bg-green-100 p-4 rounded shadow mb-4">
          <p class="text-lg font-medium">URL Generated: 
            <a href="https://url-shortener-with-authentication.onrender.com/url/<%= id %>" 
               class="text-blue-600 hover:underline">https://url-shortener-with-authentication.onrender.com/url/<%= id %>
            </a>
          </p>
        </div>
      <% } %>

      <div class="bg-white p-6 rounded shadow mb-6">
        <form method="POST" action="/url">
          <p class="text-gray-600 mb-2">Make sure your link format is of <code>http://example.com</code></p>
          <label class="block mb-2 font-medium">Enter your URL</label>
          <input type="text" name="url" placeholder="http://example.com" 
                 class="w-full p-2 border rounded mb-4" />
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
            Shorten your URL
          </button>
        </form>
      </div>

      <% if (locals.urls) { %>
      <div class="overflow-x-auto bg-white rounded shadow">
        <table class="min-w-full table-auto">
          <thead class="bg-gray-200 text-left">
            <tr>
              <th class="px-4 py-2">S.N</th>
              <th class="px-4 py-2">Short ID</th>
              <th class="px-4 py-2">Redirect</th>
              <th class="px-4 py-2">Clicks</th>
            </tr>
          </thead>
          <tbody>
            <% urls.forEach((url, index) => { %>
            <tr class="hover:bg-gray-100">
              <td class="border px-4 py-2"><%= index + 1 %></td>
              <td class="border px-4 py-2"><%= url.shortID %></td>
              <td class="border px-4 py-2"><%= url.requiredURL %></td>
              <td class="border px-4 py-2"><%= url.visitHistory.length %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </body>
</html>
